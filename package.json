{
  "name": "phone-to-today",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "node scripts/verify-v2.mjs",
    "notices": "node scripts/notices.mjs",
    "deploy": "node scripts/deploy.mjs",
    "design:review": "node scripts/render-design.mjs",
    "test:motion": "node scripts/verify-motion.mjs",
    "design:motion": "node scripts/record-motion.mjs",
    "build:demo": "STORY_FILE=stories/demo/story.json VITE_BASE_PATH=/ npm run build",
    "dev:demo": "STORY_FILE=stories/demo/story.json VITE_BASE_PATH=/ npm run dev",
    "preview:demo": "STORY_FILE=stories/demo/story.json VITE_BASE_PATH=/ npm run preview",
    "test:config": "node scripts/verify-config.mjs",
    "test:v2": "node scripts/verify-v2.mjs",
    "build:commercial": "node scripts/build-commercial.mjs",
    "preview:commercial": "node scripts/preview-commercial.mjs",
    "deploy:commercial": "node scripts/deploy-commercial.mjs",
    "test:commercial:safety": "node scripts/test-commercial-safety.mjs",
    "check:commercial": "node scripts/check-commercial.mjs",
    "order:new": "node scripts/create-order.mjs",
    "build:customer": "node scripts/build-customer.mjs",
    "preview:customer": "node scripts/preview-customer.mjs",
    "fonts:prepare": "node scripts/prepare-fonts.mjs",
    "test:customer": "node scripts/test-customer.mjs",
    "build:promo": "node scripts/build-promo.mjs",
    "check:promo": "node scripts/check-promo.mjs",
    "check:performance": "node scripts/check-commercial-performance.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
